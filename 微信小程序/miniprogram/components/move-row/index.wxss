.row,.item{display:flex;align-items:center}.row{gap:8px;padding:14px 0;border-bottom:1px solid #eef0f6}.item{flex:1;gap:11px;min-width:0}.preview{width:62px;height:65px;border-radius:12px;background:#f6f7fa;overflow:hidden;flex:none}.preview image{width:100%;height:100%;mix-blend-mode:multiply}.preview text{font-size:11px;color:#7b8395}.copy{flex:1;min-width:0}.name{font-size:13px;font-weight:600;line-height:1.5;overflow-wrap:anywhere}.meta{font-size:11px;color:#6d7585;margin-top:6px}.show{color:#2448d8;background:transparent;font-size:12px;border:0;padding:8px 0}.show::after,.select-move::after{border:0}.select-move{border:1px solid #c4cde4;background:#f1f4ff;border-radius:50%;width:36px;height:36px;padding:7px;flex-shrink:0;margin:0;display:flex;align-items:center;justify-content:center}.select-move.selected{background:#2448d8;border-color:#2448d8}.select-move image{width:22px;height:22px}
