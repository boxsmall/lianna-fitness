.row,.item,.preview,.save{display:flex;align-items:center}
.row{background:#fff;border-bottom:1rpx solid #e2e5ea;padding:0 12rpx 0 16rpx}
.item{flex:1;min-width:0;padding:16rpx 0}
.preview{width:116rpx;height:106rpx;flex-shrink:0;justify-content:center;border:1rpx solid #e1e5ed;border-radius:10rpx;overflow:hidden;background:#fff;color:#596476;font-size:21rpx}
.preview image{width:100%;height:100%}
.copy{padding:0 16rpx;min-width:0}
.name{font-weight:600;font-size:30rpx;line-height:1.45;color:#171c25}
.meta{font-size:24rpx;color:#596476;margin-top:4rpx;line-height:1.45}
.hint{color:#2448d8}
.save{width:84rpx;height:88rpx;margin:0;padding:0;justify-content:center;border:0;background:transparent}
.save image{width:38rpx;height:38rpx}
.save::after{border:none}

.plan-add{font-size:34rpx;color:#52647d;min-width:58rpx;min-height:70rpx}
