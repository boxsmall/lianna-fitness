.row,.item{display:flex;align-items:center}.row{gap:12px;padding:14px 0;border-bottom:1px solid #e0e4eb}.item{flex:1;gap:12px;min-width:0}.preview{width:64px;height:68px;border:1px solid #edf0f4;border-radius:7px;overflow:hidden;background:white;flex:none}.preview image{width:100%;height:100%}.name{font-size:14px;font-weight:650}.meta{font-size:11px;color:#697385;margin-top:6px}.show{font-size:14px;padding:8px 3px;color:#2448d8;background:transparent;border:0}.show::after{border:0}

.show.selected{background:#edf1ff;border-radius:8px;padding:8px}.show[disabled]{color:#89919e}
