.nav{position:fixed;left:0;right:0;bottom:0;z-index:5;display:flex;background:#fbfaf7;border-top:1px solid #e0e4eb;padding:8px 0 calc(6px + env(safe-area-inset-bottom))}.nav button{border:0;background:transparent;display:flex;align-items:center;flex-direction:column;gap:4px;width:25%;font-size:10px;line-height:14px;color:#737d8c}.nav button::after{border:0}.nav image{width:20px;height:20px}.nav button.active{color:#2448d8}
