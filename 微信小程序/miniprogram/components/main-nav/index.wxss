.nav{position:fixed;bottom:0;left:0;right:0;z-index:6;display:flex;background:#eef1fb;border-top:1px solid #e8ebf4;padding:6px 8px calc(8px + env(safe-area-inset-bottom));box-sizing:border-box}.nav-item{flex:1;background:transparent;border:0;margin:0;padding:0;line-height:1.4;font-size:10px;color:#68718a;display:flex;flex-direction:column;align-items:center;gap:4px}.nav-item::after{border:0}.icon-pill{width:56px;height:30px;border-radius:20px;display:flex;align-items:center;justify-content:center}.active .icon-pill{background:#dce4ff}.active{color:#203b8b;font-weight:600}.icon-pill image{width:22px;height:22px}
