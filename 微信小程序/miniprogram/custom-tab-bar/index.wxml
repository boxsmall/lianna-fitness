<view wx:if="{{!hidden}}" class="nav"><button wx:for="{{tabs}}" wx:key="key" data-page="{{item.key}}" bindtap="follow" class="tab {{selected===item.key?'active':''}}" aria-label="{{item.label}}" aria-current="{{selected===item.key?'page':'false'}}"><view class="icon-pill"><image src="/assets/tdesign/{{item.icon}}-{{selected===item.key?'blue':'muted'}}.svg" mode="aspectFit"/></view><text>{{item.label}}</text></button></view>
