.modes,.tools{display:flex;align-items:center}
.mode,.dropdown,.search{border:2rpx solid #d9dde4;border-radius:12rpx;background:white}
.mode{padding:16rpx 26rpx;margin-right:14rpx;font-weight:600}
.mode.on,.tile.on{color:#2448d8;background:#edf1ff;border-color:#2448d8}
.tools{margin:22rpx 0 12rpx}
.search{min-width:0;flex:1;height:80rpx;padding:0 16rpx;margin-right:12rpx}
.dropdown{display:flex;align-items:center;min-height:80rpx;padding:0 14rpx;font-size:26rpx}
.summary{min-height:66rpx;font-size:26rpx}
.tiles{display:flex;flex-wrap:wrap;margin:14rpx -5rpx 0}
.tile{position:relative;display:flex;align-items:center;flex-direction:column;width:calc(33.333% - 10rpx);margin:0 5rpx 10rpx;padding:12rpx 7rpx 14rpx;background:white;border:2rpx solid #d9dde4;border-radius:12rpx}
.tile[disabled]{opacity:.52}
.tile image{width:100%;height:102rpx;margin-bottom:8rpx}
.check{position:absolute;right:8rpx;top:8rpx;width:30rpx;height:30rpx;border:2rpx solid #a6adba;border-radius:6rpx;background:white;line-height:26rpx;font-size:22rpx}
.on .check{background:#2448d8;color:#fff;border-color:#2448d8}
.tile-name{font-size:24rpx;font-weight:600}
.note{font-size:20rpx;color:#596476}
