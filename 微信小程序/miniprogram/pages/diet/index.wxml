<view class="screen diet-screen"><view class="header"><text class="title">{{mode==='profile'?'先了解一下你':(mode==='energy'?'设置每日目标':(mode==='meal'?mealNames[index]+'怎么搭配':'今日饮食'))}}</text><image class="brand" src="/assets/brand.svg" mode="aspectFit"/></view>
<view wx:if="{{error}}" class="error">{{error}}</view>
<block wx:if="{{mode==='profile'}}"><view class="subtitle">选定阶段目标，训练和饮食一起配合。</view><view class="pills"><button wx:for="{{goals}}" wx:key="*this" class="chip {{form.goal===item?'on':''}}" data-value="{{item}}" bindtap="goal">{{item}}</button></view><view class="section-head strong">性别</view><view class="pills"><button wx:for="{{sexes}}" wx:key="*this" class="chip {{form.sex===item?'on':''}}" data-value="{{item}}" bindtap="sex">{{item}}</button></view><view class="fields"><label>身高 · cm<input type="digit" class="field" placeholder="例如 165" value="{{form.height}}" data-k="height" bindinput="input"/></label><label>体重 · kg<input type="digit" class="field" placeholder="例如 62.5" value="{{form.weight}}" data-k="weight" bindinput="input"/></label></view><label>阶段目标体重 · kg（选填）<input class="field" type="digit" value="{{form.targetWeight}}" data-k="targetWeight" bindinput="input" placeholder="不填也可制定方案"/></label><view class="section-head strong">过敏原 <text class="muted">选填，可多选</text></view><view class="pills"><button wx:for="{{allergenOptions}}" wx:key="name" class="chip {{item.checked?'on':''}}" bindtap="toggleAllergen" data-name="{{item.name}}">{{item.name}}</button></view><label class="muted">其他过敏原<input class="field" placeholder="花生、牛奶等，可多选" value="{{form.allergens}}" data-k="allergens" bindinput="input"/></label><label>忌口 · 选填<input class="field" placeholder="例如，不吃猪肉" value="{{form.avoid}}" data-k="avoid" bindinput="input"/></label><view class="callout">资料保存后可随时修改。已标记的过敏原会用于筛选食材。</view><button class="primary" bindtap="next">继续设置每日目标</button></block>
<block wx:elif="{{mode==='energy'}}"><view class="subtitle">当前目标：{{form.goal}}。先确认饮食总量，再分配到每一餐。</view><view class="pills"><button class="chip {{!form.estimate?'on':''}}" bindtap="estimate" data-value="{{0}}">我有目标</button><button class="chip {{form.estimate?'on':''}}" bindtap="estimate" data-value="{{1}}">帮我估算</button></view><block wx:if="{{form.estimate}}">
<label>年龄<input class="field" type="number" value="{{form.age}}" data-k="age" bindinput="input"/>
</label>
<picker range="{{levels}}" data-k="activity" data-list="levels" bindchange="pick">
<view class="field">通常整周活动 · {{form.activity}} ▾</view>
</picker><view class="fine">综合工作、走动和通常实际训练。久坐：多数时间坐着、运动少；轻活动：有规律走动或轻量运动；中等活动：经常走动并有规律训练。高体力劳动请用专业目标。</view><view class="switch-row"><text>通常有抗阻训练（选填）</text><switch checked="{{form.resistance}}" data-k="resistance" bindchange="input"/></view>
<view class="switch-row"><text>我是一般健康成年人，非孕哺期且无医嘱饮食限制（选填）</text><switch checked="{{form.generalAdult}}" data-k="generalAdult" bindchange="input"/>
</view>
<view class="fine">以上两项可不选，不影响继续估算。通用估算面向一般健康、非孕哺期且无医嘱饮食限制的成年人；有特殊饮食需求时，请选择“我有目标”填写专业目标。</view>
<view wx:if="{{form.goal==='增肌' && !form.resistance}}" class="fine">增肌目标需要配合抗阻训练；可先估算饮食，再安排训练。</view>
</block>
<label wx:else>已有每日能量目标（千卡）<input class="field" type="digit" value="{{form.kcal}}" data-k="kcal" bindinput="input"/>
</label>
<view wx:if="{{!form.estimate}}" class="switch-row"><text>填写已有三类营养目标</text><switch checked="{{form.useManualMacros}}" data-k="useManualMacros" bindchange="input"/></view><view wx:if="{{form.estimate}}" class="callout">按{{form.goal}}目标计算摄入，营养目标随热量一起更新。通常训练已包含，不额外加回运动消耗。</view>
<view wx:if="{{!form.estimate && form.useManualMacros}}"><view class="section-head strong">营养目标 · 克 / 天</view><view class="fields"><label>碳水<input class="field" type="digit" value="{{form.carb}}" data-k="carb" bindinput="input"/></label><label>蛋白质<input class="field" type="digit" value="{{form.protein}}" data-k="protein" bindinput="input"/></label><label>脂肪<input class="field" type="digit" value="{{form.fat}}" data-k="fat" bindinput="input"/></label></view></view>
<label wx:if="{{form.estimate && form.goal !== '维持'}}">{{form.goal==='减脂'?'初始热量缺口':'初始热量盈余'}} · %（可调整）<input class="field" type="digit" value="{{form.goalPercent}}" placeholder="使用后台默认值" data-k="goalPercent" bindinput="input"/></label><view wx:if="{{previewError}}" class="fine">{{previewError}}</view><view wx:if="{{targetPreview}}" class="vcard"><view class="strong">目标预览 · 尚未保存</view><view class="metric">{{targetPreview.targets.kcal}} <text>千卡 / 天</text></view><view wx:if="{{!targetPreview.reviewRequired}}">碳水 {{targetPreview.targets.carb}} g · 蛋白质 {{targetPreview.targets.protein}} g · 脂肪 {{targetPreview.targets.fat}} g</view><view wx:if="{{macroDelta}}" class="fine">相比上次预览：{{macroDelta}}</view><view wx:if="{{targetPreview.energy}}" class="fine">维持估算 {{targetPreview.energy.maintenance}} 千卡 · BMI {{targetPreview.energy.bmi}}（仅作参考）</view><view wx:if="{{targetPreview.energy.ageNotice}}" class="fine">{{targetPreview.energy.ageNotice}}</view><view wx:if="{{targetPreview.macroDifference > 10 || -10 > targetPreview.macroDifference}}" class="callout">营养反算与总热量差额 {{targetPreview.macroDifference}} 千卡，保存时可选择修正或保留。</view><view wx:if="{{targetPreview.reviewRequired}}" class="callout">{{targetPreview.reviewReason}}<button class="link" data-value="{{0}}" bindtap="estimate">填写已有专业目标</button></view></view><view class="callout">三餐默认按 30% / 40% / 30% 分配，确认后可调整。</view><button class="primary" bindtap="saveProfile">确认目标，查看三餐</button><button class="link wide" data-mode="profile" bindtap="screen">修改饮食资料</button></block>
<block wx:elif="{{mode==='nutrition'}}"><view class="subtitle">{{date}} · 已安排的饮食目标</view><view wx:if="{{legacy}}" class="callout">这是原已确认目标，尚未按阶段目标重新评估。调整目标可重新估算。</view><view wx:if="{{pending}}" class="callout">{{pending.effectiveFrom}} 起饮食目标 {{pending.profile.targets.kcal}} 千卡</view><view class="vcard"><view class="between"><text class="muted">每日{{form.goal}}饮食目标</text><button class="link" data-mode="energy" bindtap="screen">调整目标</button></view><view class="metric">{{form.kcal||'—'}} <text>千卡 / 天</text></view><view class="metric-grid"><view><text class="muted">碳水</text><view class="num">{{form.carb}} <text>g</text></view></view><view><text class="muted">蛋白质</text><view class="num">{{form.protein}} <text>g</text></view></view><view><text class="muted">脂肪</text><view class="num">{{form.fat}} <text>g</text></view></view></view></view><view class="between section-head"><text class="heading">一餐一餐搭配</text><button class="link" bindtap="editRatios">分餐比例</button></view><view wx:for="{{meals}}" wx:key="index" class="vcard"><view class="between"><text class="strong">{{item.name}}</text><text>{{item.kcal}} 千卡</text></view><view class="fine">碳水 · 蛋白质 · 脂肪　{{item.carb}} · {{item.protein}} · {{item.fat}} g</view><view class="between"><text class="muted">全天占比 {{item.share}}%</text><button class="link" data-i="{{index}}" bindtap="changeMeal">选食材</button></view></view><view class="between"><button class="link" bindtap="explain">计算依据</button><button class="link" data-page="progress" bindtap="follow">体重趋势与调整</button></view><button class="link" bindtap="toggleHistory">{{historyOpen?'收起':'查看'}}目标调整历史</button><view wx:if="{{historyOpen}}" class="vcard"><view wx:if="{{!goalHistory.length}}" class="fine">暂无历史调整</view><view wx:for="{{goalHistory}}" wx:key="index" class="menu-row"><view>{{item.date}} · {{item.goal}} · {{item.kcal}} 千卡</view><view class="fine">碳水 {{item.carb}} g · 蛋白质 {{item.protein}} g · 脂肪 {{item.fat}} g</view><view class="fine">{{item.reason}}</view></view></view></block>
<block wx:else><view class="subtitle">选择你想吃的食物，我们帮你算份量。</view><view class="vcard"><view class="between"><text class="strong">本餐目标</text><text>{{result.target.kcal||0}} 千卡</text></view><view class="metric-grid"><block wx:for="{{metrics}}" wx:key="name"><view wx:if="{{index>0}}"><text class="muted">{{item.name}}目标</text><view class="num">{{item.target}} <text>g</text></view><view class="muted">当前 {{item.actual}} g</view><view class="muted">{{item.deltaText}}</view></view></block></view></view>
<block wx:for="{{sections}}" wx:for-item="section" wx:key="type"><view class="section-head between"><text class="heading">{{section.label}}</text><button class="link" data-type="{{section.type==='other'?'':section.type}}" bindtap="openFoods">选食材</button></view><view wx:for="{{section.rows}}" wx:key="id" class="vcard recipe-card"><view class="between"><view><view class="strong">{{item.name}}</view><text class="muted">{{item.state}}</text></view><view class="inline-actions"><input class="field meal-weight" type="digit" value="{{item.grams}}" data-id="{{item.id}}" bindinput="grams"/>克</view></view><view class="rule"></view><view class="inline-actions"><button class="link" data-id="{{item.id}}" data-type="{{section.type}}" bindtap="openFoods">换一种</button><button class="link" data-id="{{item.id}}" data-op="{{item.locked==null?'lock':'unlock'}}" bindtap="row">{{item.locked==null?'锁定份量':'解锁'}}</button><button class="link" data-id="{{item.id}}" data-op="remove" bindtap="row">移除</button></view></view></block><button class="link" bindtap="openFoods">全部食材</button><button class="link" bindtap="suggest">推荐搭配</button><button wx:for="{{recommendations}}" wx:key="id" class="link" data-id="{{item.id}}" bindtap="add">{{item.name}} · {{item.reason}}</button><button class="primary {{(!items.length)?'is-disabled':''}}" bindtap="save" disabled="{{!items.length}}">保存本餐搭配</button><view wx:if="{{history}}" class="fine">计划搭配 · 上次保存 {{history.actual.kcal}} 千卡 · 食材版本 {{history.foodsVersion}}</view><view wx:if="{{history}}"><button wx:if="{{!consumed}}" class="link" bindtap="consume">填写实际份量，记为已吃</button><view wx:else class="callout">已确认摄入 {{consumed.actual.kcal}} 千卡。修改计划搭配不改变这份摄入记录。<button class="link" bindtap="consume">修改实际份量</button><button class="link" bindtap="unconsume">撤销已吃记录</button></view></view><button class="link wide" data-mode="nutrition" bindtap="screen">返回今日饮食</button></block>
<view wx:if="{{actualOpen}}" class="scrim"><view class="sheet"><view class="between"><text class="heading">实际吃下的份量</text><button class="link" bindtap="closeActual">关闭</button></view><view class="fine">仅更新实际摄入，计划搭配不变。</view><scroll-view scroll-y style="max-height:500rpx"><label wx:for="{{actualDraft}}" wx:key="id">{{item.name}} · 克<input class="field" type="digit" value="{{item.grams}}" data-id="{{item.id}}" bindinput="actualGrams"/></label></scroll-view><button class="primary" bindtap="saveActual">确认实际份量</button></view></view><view wx:if="{{ratioOpen}}" class="scrim"><view class="sheet"><view class="between"><text class="heading">分餐比例</text><button class="link" bindtap="closeRatios">关闭</button></view><view class="between"><text>启用加餐</text><switch checked="{{snackEnabled}}" bindchange="toggleSnack"/></view><label>{{snackEnabled?'早餐、午餐、晚餐、加餐':'早餐、午餐、晚餐'}}（合计100%）<input class="field" placeholder="例如 25,35,30,10" value="{{ratioDraft}}" bindinput="ratioInput"/></label><button class="primary" bindtap="saveRatios">保存比例</button></view></view><view wx:if="{{showFoods}}" class="scrim"><view class="sheet">
<view class="between">
<view class="subheading">{{replaceId?'选择替换食材':'选择食材'}}</view>
<button class="link" bindtap="closeFoods">收起</button>
</view>
<scroll-view scroll-y style="height:410rpx">
<button wx:for="{{choicesForMeal}}" wx:key="id" class="vrow" data-id="{{item.id}}" bindtap="selectFood">{{item.name}} · {{item.state}}</button>
</scroll-view>
</view>
</view></view>
