<view class="screen"><view class="header"><text class="title">{{mode==='profile'?'先了解一下你':(mode==='energy'?'设置每日目标':(mode==='meal'?mealNames[index]+'怎么搭配':'今日饮食'))}}</text><image class="brand" src="/assets/brand.svg" mode="aspectFit"/></view>
<view wx:if="{{error}}" class="error">{{error}}</view>
<block wx:if="{{mode==='profile'}}"><view class="subtitle">用来制定你的每日能量和营养目标。</view><view class="section-head strong">性别</view><view class="pills"><button wx:for="{{sexes}}" wx:key="*this" class="chip {{form.sex===item?'on':''}}" data-value="{{item}}" bindtap="sex">{{item}}</button></view><view class="fields"><label>身高 · cm<input type="digit" class="field" placeholder="例如 165" value="{{form.height}}" data-k="height" bindinput="input"/></label><label>体重 · kg<input type="digit" class="field" placeholder="例如 62.5" value="{{form.weight}}" data-k="weight" bindinput="input"/></label></view><view class="section-head strong">过敏原 <text class="muted">选填，可多选</text></view><view class="pills"><button wx:for="{{allergenOptions}}" wx:key="name" class="chip {{item.checked?'on':''}}" bindtap="toggleAllergen" data-name="{{item.name}}">{{item.name}}</button></view><label class="muted">其他过敏原<input class="field" placeholder="花生、牛奶等，可多选" value="{{form.allergens}}" data-k="allergens" bindinput="input"/></label><label>忌口 · 选填<input class="field" placeholder="例如，不吃猪肉" value="{{form.avoid}}" data-k="avoid" bindinput="input"/></label><view class="callout">资料保存后可随时修改。已标记的过敏原会用于筛选食材。</view><button class="primary" bindtap="next">继续设置每日目标</button></block>
<block wx:elif="{{mode==='energy'}}"><view class="subtitle">先确认总量，再分配到每一餐。</view><view class="pills"><button class="chip {{!form.estimate?'on':''}}" bindtap="estimate" data-value="{{0}}">我有目标</button><button class="chip {{form.estimate?'on':''}}" bindtap="estimate" data-value="{{1}}">帮我估算</button></view><block wx:if="{{form.estimate}}">
<label>年龄<input class="field" type="number" value="{{form.age}}" data-k="age" bindinput="input"/>
</label>
<picker range="{{levels}}" data-k="activity" data-list="levels" bindchange="pick">
<view class="field">日常活动水平 · {{form.activity}} ▾</view>
</picker>
<view>我是一般健康成年人，非孕哺期且无医嘱饮食限制 <switch checked="{{form.generalAdult}}" data-k="generalAdult" bindchange="input"/>
</view>
</block>
<label wx:else>已有每日能量目标（千卡）<input class="field" type="digit" value="{{form.kcal}}" data-k="kcal" bindinput="input"/>
</label>
<view class="muted">已有三类营养目标时一并填写（克）</view>
<view class="picks">
<input class="field" type="digit" placeholder="碳水" value="{{form.carb}}" data-k="carb" bindinput="input"/>
<input class="field" type="digit" placeholder="蛋白质" value="{{form.protein}}" data-k="protein" bindinput="input"/>
<input class="field" type="digit" placeholder="脂肪" value="{{form.fat}}" data-k="fat" bindinput="input"/>
</view>
<view class="callout">三餐默认按 30% / 40% / 30% 分配，确认后可调整。</view><button class="primary" bindtap="saveProfile">确认目标，查看三餐</button><button class="link wide" data-mode="profile" bindtap="screen">修改饮食资料</button></block>
<block wx:elif="{{mode==='nutrition'}}"><view class="subtitle">{{date}}</view><view class="vcard"><view class="between"><text class="muted">建议总能量</text><button class="link" data-mode="energy" bindtap="screen">调整目标</button></view><view class="metric">{{form.kcal||'—'}} <text>千卡 / 天</text></view><view class="metric-grid"><view><text class="muted">碳水</text><view class="num">{{form.carb}} <text>g</text></view></view><view><text class="muted">蛋白质</text><view class="num">{{form.protein}} <text>g</text></view></view><view><text class="muted">脂肪</text><view class="num">{{form.fat}} <text>g</text></view></view></view></view><view class="between section-head"><text class="heading">一餐一餐搭配</text><button class="link" bindtap="editRatios">分餐比例</button></view><view wx:for="{{meals}}" wx:key="index" class="vcard"><view class="between"><text class="strong">{{item.name}}</text><text>{{item.kcal}} 千卡</text></view><view class="fine">碳水 · 蛋白质 · 脂肪　{{item.carb}} · {{item.protein}} · {{item.fat}} g</view><view class="between"><text class="muted">全天占比 {{item.share}}%</text><button class="link" data-i="{{index}}" bindtap="changeMeal">选食材</button></view></view></block>
<block wx:else><view class="subtitle">选择你想吃的食物，我们帮你算份量。</view><view class="vcard"><view class="between"><text class="strong">本餐目标</text><text>{{result.target.kcal||0}} 千卡</text></view><view class="metric-grid"><block wx:for="{{metrics}}" wx:key="name"><view wx:if="{{index>0}}"><text class="muted">{{item.name}}目标</text><view class="num">{{item.target}} <text>g</text></view><view class="muted">当前 {{item.actual}} g</view><view class="muted">{{item.deltaText}}</view></view></block></view></view>
<block wx:for="{{sections}}" wx:for-item="section" wx:key="type"><view class="section-head between"><text class="heading">{{section.label}}</text><button class="link" data-type="{{section.type==='other'?'':section.type}}" bindtap="openFoods">选食材</button></view><view wx:for="{{section.rows}}" wx:key="id" class="vcard recipe-card"><view class="between"><view><view class="strong">{{item.name}}</view><text class="muted">{{item.state}}</text></view><view class="inline-actions"><input class="field meal-weight" type="digit" value="{{item.grams}}" data-id="{{item.id}}" bindinput="grams"/>克</view></view><view class="rule"></view><view class="inline-actions"><button class="link" data-id="{{item.id}}" data-type="{{section.type}}" bindtap="openFoods">换一种</button><button class="link" data-id="{{item.id}}" data-op="{{item.locked==null?'lock':'unlock'}}" bindtap="row">{{item.locked==null?'锁定份量':'解锁'}}</button><button class="link" data-id="{{item.id}}" data-op="remove" bindtap="row">移除</button></view></view></block><button class="link" bindtap="openFoods">全部食材</button><button class="link" bindtap="suggest">推荐搭配</button><button wx:for="{{recommendations}}" wx:key="id" class="link" data-id="{{item.id}}" bindtap="add">{{item.name}} · {{item.reason}}</button><button class="primary" bindtap="save" disabled="{{!items.length}}">保存本餐搭配</button><view wx:if="{{history}}" class="fine">上次保存 {{history.actual.kcal}} 千卡 · 食材版本 {{history.foodsVersion}}</view><button class="link wide" data-mode="nutrition" bindtap="screen">返回今日饮食</button></block>
<view wx:if="{{ratioOpen}}" class="scrim"><view class="sheet"><view class="between"><text class="heading">分餐比例</text><button class="link" bindtap="closeRatios">关闭</button></view><label>早餐、午餐、晚餐（合计 100%）<input class="field" value="{{ratioDraft}}" bindinput="ratioInput"/></label><button class="primary" bindtap="saveRatios">保存比例</button></view></view><view wx:if="{{showFoods}}" class="scrim"><view class="sheet">
<view class="between">
<view class="subheading">{{replaceId?'选择替换食材':'选择食材'}}</view>
<button class="link" bindtap="closeFoods">收起</button>
</view>
<scroll-view scroll-y style="height:410rpx">
<button wx:for="{{choicesForMeal}}" wx:key="id" class="vrow" data-id="{{item.id}}" bindtap="selectFood">{{item.name}} · {{item.state}}</button>
</scroll-view>
</view>
</view></view>
