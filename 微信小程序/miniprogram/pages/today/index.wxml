<view class="screen"><view class="header"><text class="title">今天练哪</text><image class="brand" src="/assets/brand.svg" mode="aspectFit"/></view>
<view class="subtitle">{{caption}}</view>
<view class="day-strip"><button wx:for="{{days}}" wx:key="date" class="day {{item.active?'on':''}}" bindtap="follow" data-page="week" data-date="{{item.date}}">{{item.weekday}}<text>{{item.number}}</text><view class="dot"/></button></view>
<view class="training-card"><image class="person" src="/assets/0334.webp" webp mode="aspectFit"/><view class="hero-copy"><text class="tag">今日训练</text><view class="hero-title">{{session?session.type:'安排今天训练'}}</view><view class="muted">{{session?session.budget+' 分钟 · '+gear:'自己选动作，组合今天想练的一组。'}}</view><view class="muted hero-sub">{{session?session.items.length+' 个动作 · '+session.status:'按自己的节奏开始训练'}}</view></view><button class="primary" bindtap="openTraining" data-page="week" data-date="{{date}}" data-mode="session">{{session?(session.status==='待训练'?'开始训练':'查看训练'):'选择今天的动作'}}</button></view>
<view class="section-head between"><text class="heading">今日饮食</text><button class="link" data-page="diet" bindtap="follow">查看</button></view>
<view class="vcard"><view class="between"><text class="muted">今日{{profile.goal||''}}饮食目标</text><text class="tag">{{profile?'目标已确认':'待设置'}}</text></view><view class="metric">{{energy}} <text>千卡 / 天</text></view><view wx:if="{{lunch}}"><view class="between"><text class="strong">午餐</text><text>{{lunch.kcal}} 千卡</text></view><view class="subtitle">碳水 {{lunch.carb}} g · 蛋白质 {{lunch.protein}} g · 脂肪 {{lunch.fat}} g</view><button class="link" data-page="diet" data-mode="meal" data-meal="1" bindtap="follow">选食材，算份量</button></view><button wx:else class="link" data-page="diet" data-mode="profile" bindtap="follow">设置我的饮食目标</button></view>
<view class="vcard"><view class="strong">体重趋势与执行反馈</view><view class="fine">记录体重，结合实际效果评估饮食目标。</view><button class="link" data-page="progress" bindtap="follow">记录 / 查看趋势</button></view><view class="section-head between"><text class="heading">我的一周</text><button class="link" data-page="week" bindtap="follow">调整安排</button></view><view class="muted">{{planSummary}}</view><view class="error">{{error}}</view></view>
