<view class="screen today-screen"><view class="today-top"><text>{{caption}}</text><image class="brand" src="/assets/brand.svg" mode="aspectFit"/></view><view class="title">把今天，练好。</view><view class="subtitle">按自己的节奏，一次进步一点。</view>
<view class="day-strip"><button wx:for="{{days}}" wx:key="date" class="day {{item.active?'on':''}}" bindtap="follow" data-page="week" data-mode="session" data-date="{{item.date}}"><text class="weekday">{{item.weekday}}</text><text class="day-number">{{item.number}}</text><view class="dot {{item.scheduled?'':'none'}}"/></button></view>
<view class="training-card"><view class="hero-copy"><text class="eyebrow">TODAY’S TRAINING</text><view class="hero-title">{{session?(session.name||'今天的训练'):'今天想练什么？'}}</view><view class="hero-desc">{{session?sessionItemCount+' 个动作 · '+gear:'从喜欢的动作开始'}}</view><view class="hero-meta"><image class="icon small" src="/assets/tdesign/time-blue.svg"/><text>{{session?'约 '+sessionMinutes+' 分钟':'自由安排，不用先排一周'}}</text></view></view><image class="person" src="{{heroCover}}" webp mode="aspectFit"/><button class="primary" bindtap="openTraining"><image class="icon" src="/assets/tdesign/play-circle-white.svg"/>{{session?'查看今天的训练':'创建今天的训练'}}</button></view>
<view class="quick-actions"><button class="quick-action" bindtap="newTraining"><image class="icon" src="/assets/tdesign/add-blue.svg"/>新建今天训练</button><button class="quick-action" bindtap="follow" data-page="pick"><image class="icon" src="/assets/tdesign/view-list-blue.svg"/>去动作库挑选</button></view>
<view class="section-head between"><text class="heading">今天怎么吃</text><button class="link" bindtap="follow" data-page="diet">三餐搭配<image class="icon small" src="/assets/tdesign/chevron-right-blue.svg"/></button></view><view class="diet-summary"><view class="between"><view><text class="muted">每日能量目标</text><view class="metric">{{energy}} <text>千卡</text></view></view><text class="tag {{profile?'green':''}}">{{profile?'目标已确认':'待设置'}}</text></view><view wx:if="{{profile}}" class="macro-inline"><view><text>碳水</text><view>{{profile.targets.carb}} g</view></view><view><text>蛋白质</text><view>{{profile.targets.protein}} g</view></view><view><text>脂肪</text><view>{{profile.targets.fat}} g</view></view></view><button wx:else class="link" data-page="diet" data-mode="profile" bindtap="follow">设置我的饮食目标</button></view>
<button class="week-link" data-page="week" bindtap="follow"><image class="icon" src="/assets/tdesign/calendar-muted.svg"/><view class="grow"><view class="strong">一周安排</view><view class="fine">{{planSummary}}</view></view><image class="icon small" src="/assets/tdesign/chevron-right-muted.svg"/></button><button class="link" data-page="progress" bindtap="follow">体重趋势与目标调整</button><view class="error" wx:if="{{error}}">{{error}}</view></view>
