.today-top{display:flex;align-items:center;justify-content:space-between;margin:0 0 10px;color:#626774;font-size:11px}.today-screen>.title{font-size:29px}.today-screen>.subtitle{margin-bottom:20px}.day-strip{display:flex;gap:8px;margin:18px 0 20px}.day{flex:1;border:0;background:transparent;border-radius:23px;padding:9px 0 8px;color:#7b8395;font-size:11px;min-width:0}.weekday,.day-number{display:block}.day-number{font-size:17px;font-weight:700;color:#202330;margin:2px 0}.dot{width:4px;height:4px;border-radius:50%;background:#8096d3;margin:5px auto 0}.dot.none{opacity:0}.day.on{background:#2448d8;color:white}.day.on .day-number{color:white}.day.on .dot{background:white}.training-card{position:relative;overflow:hidden;padding:22px 18px 16px;border-radius:26px;background:#dfe5ff;color:#14276a}.hero-copy{position:relative;z-index:1;width:calc(100% - 114px);min-height:130px}.eyebrow{font-size:9px;letter-spacing:1.1px;color:#465a99;font-weight:600}.hero-title{font-size:23px;font-weight:700;margin:11px 0 6px;line-height:1.3}.hero-desc{font-size:12px;color:#465a87}.hero-meta{display:flex;align-items:center;gap:5px;font-size:11px;color:#465a87;margin-top:13px}.person{position:absolute;right:-3px;top:9px;width:126px;height:151px;mix-blend-mode:multiply}.training-card>.primary{position:relative;z-index:1;margin-top:12px}.quick-actions{display:flex;gap:8px;margin-top:12px}.quick-action{flex:1;display:flex;align-items:center;justify-content:center;gap:6px;background:#eff1fa;min-height:51px;border-radius:14px;font-size:12px;color:#273a70}.quick-action .icon{width:18px;height:18px}.diet-summary{background:white;border:1px solid #e5e8f1;border-radius:20px;padding:18px}.diet-summary .metric{margin:5px 0 0;font-size:30px}.macro-inline{display:flex;justify-content:space-between;border-top:1px solid #e7e9f2;padding-top:13px;margin-top:15px;font-size:12px;color:#272e43}.macro-inline text{font-size:11px;color:#676d7c}.macro-inline view>view{margin-top:4px;font-weight:600}.week-link{display:flex;align-items:center;gap:12px;padding:18px 0;width:100%;text-align:left}.week-link .fine{margin:4px 0 0}
