.day-strip{display:flex;gap:6px;margin:22px 0}.day{flex:1;background:white;border:1px solid #e0e4eb;border-radius:9px;padding:10px 0;color:#697385;font-size:10px}.day text{display:block;margin:7px 0;font-size:17px;font-weight:700;color:#171c25}.dot{width:4px;height:4px;border-radius:50%;background:#bbc3d3;margin:auto}.day.on{background:#2448d8;border-color:#2448d8;color:white}.day.on text{color:white}.day.on .dot{background:white}.training-card{overflow:hidden;position:relative;padding:20px;background:#edf1ff;border:1px solid #d8e0ff;border-radius:12px}.person{width:120px;height:156px;position:absolute;right:0;top:0;mix-blend-mode:multiply}.hero-copy{position:relative;padding-right:82px}.hero-title{font-size:24px;font-weight:700;margin:12px 0}.hero-sub{margin-top:9px}.training-card .primary{margin-top:18px;position:relative}
