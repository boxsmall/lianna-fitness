.start-training{border-radius:24px;background:#dfe5ff;padding:21px;margin-top:22px}.start-training .heading{font-size:21px}.start-training .muted{margin:7px 0 16px}.week-course{background:white;border:1px solid #e3e7f1;border-radius:20px;padding:20px;margin:14px 0}.week-course>.heading{margin-top:17px;font-size:18px}.course-summary{padding:14px 0;margin-top:12px;border-top:1px solid #edf0f7}.course-controls{border-top:1px solid #edf0f7;padding-top:4px}.session-screen{padding-bottom:calc(145px + env(safe-area-inset-bottom))}.session-subtitle{margin:-2px 0 14px}.session-name{background:#eff1fa;border-radius:16px;padding:12px 16px}.session-name input{border:0;border-bottom:1px solid #bec6dc;padding:8px 0 5px;height:38px;font-size:18px;font-weight:600;color:#263252}.session-stats{display:flex;justify-content:space-between;padding:18px 2px;color:#6c7484;font-size:11px}.session-stats text{font-size:20px;margin-right:4px;font-weight:600;color:#243256}.warmup-line{display:flex;align-items:center;gap:7px;padding:4px 11px;background:#f0f1f7;border-radius:12px;font-size:11px;color:#586278}.warmup-line .link{margin-left:auto;font-size:11px}.warmup-items{padding:8px 11px}.session-exercise{border:1px solid #e0e5f1;background:white;border-radius:18px;padding:12px;margin-bottom:12px}.exercise-head{display:flex;align-items:center;gap:7px}.ordinal{font-size:11px;color:#7c869a}.exercise-view{display:flex;align-items:center;gap:11px;text-align:left;flex:1;min-width:0}.exercise-view image{width:62px;height:65px;flex-shrink:0;border-radius:12px;background:#f6f7fa;mix-blend-mode:multiply}.exercise-view .strong{font-size:13px;line-height:1.5}.exercise-view .muted{font-size:11px;margin-top:7px}.icon-button{padding:5px;width:32px;min-height:40px;flex-shrink:0;display:flex;align-items:center;justify-content:center}.prescription{display:flex;align-items:center;justify-content:space-between;background:#f1f4fc;color:#52607e;border-radius:10px;padding:11px 12px;width:100%;font-size:11px;margin-top:10px;gap:6px}.prescription text{font-weight:600;color:#304672;font-size:14px}.prescription>view:last-child{display:flex;align-items:center;gap:7px}.add-outline{border:1px dashed #aebbdc;border-radius:14px;margin:5px 0 15px;font-size:13px}.session-picker{margin-bottom:14px}.session-picker .chip{font-size:11px}.empty .heading{margin-top:12px;font-size:16px}

.goal-note{display:flex;align-items:center;justify-content:space-between;margin:-18px 0 14px;font-size:11px;color:#626774}.goal-note .link{min-height:30px;font-size:11px}

.exercise-editor .between>.heading{flex:1;min-width:0;margin:0;font-size:18px}.exercise-editor>.between{margin-bottom:20px}.editor-scroll{height:55vh}.editor-future{font-size:12px;margin:0 0 20px}.editor-future switch{transform:scale(.8);transform-origin:right center}.editor-actions{display:flex;gap:8px;margin:16px 0}.editor-actions .link{flex:1;min-height:44px;margin:0;border:1px solid #e1e5ef;border-radius:12px;background:#f8f9ff}.editor-actions .danger{color:#a13127}.candidate{padding:14px 0;border-top:1px solid #e3e7f0}.exercise-editor .fields{gap:12px}
