<view class="screen {{mode==='session'?'session-screen':''}}"><view class="header"><text class="title">{{mode==='create'?'安排你的一周':(mode==='session'?(session.name||'今天的训练'):'训练')}}</text><image class="brand" src="/assets/brand.svg" mode="aspectFit"/></view>
<view class="error" wx:if="{{error}}">{{error}}</view>
<block wx:if="{{mode==='create'}}"><view class="subtitle">根据目标、时间和现有器械来排。</view>
<view class="section-head strong">本次训练方向</view><view class="pills"><button wx:for="{{goals}}" wx:key="*this" class="chip {{goal===item?'on':''}}" data-k="goal" data-v="{{item}}" bindtap="option">{{item}}</button></view>
<view class="goal-note"><text>本次选择只影响新训练。</text><button class="link" data-page="diet" data-mode="profile" bindtap="follow">更改阶段目标</button></view><view class="strong">每周练几天</view><view class="pills"><button wx:for="{{daysList}}" wx:key="*this" class="chip {{days===item?'on':''}}" data-k="days" data-v="{{item}}" bindtap="option">{{item}}</button></view>
<view class="strong">每次多久 · 分钟</view><view class="pills"><button wx:for="{{minutesList}}" wx:key="*this" class="chip {{minutes===item?'on':''}}" data-k="minutes" data-v="{{item}}" bindtap="option">{{item}}</button></view>
<view class="between"><text class="strong">使用我的器械</text><button class="link" bindtap="gear">修改</button></view><view class="vcard between" bindtap="gear"><image wx:if="{{gearImage}}" style="width:64px;height:54px" src="{{gearImage}}" mode="aspectFit"/><text>{{gearLabel}}</text><text class="muted">{{gear.length ? '搭配徒手动作' : '使用自身体重训练'}}</text></view>
<view class="strong">训练经验 · 选填</view><picker range="{{experiences}}" data-k="experience" data-list="experiences" bindchange="choose"><view class="field">{{experience==='基础'?'刚开始，先从基础动作练起':experience}}　⌄</view></picker>
<view class="callout">{{manualDays?'5～7 天支持自己编排，可从四天模板开始。':'先安排错开的训练日，生成后仍可调日期、动作和组次。'}}</view><button class="link" bindtap="toggleAdvanced">指定训练日与编排方式</button><view wx:if="{{advanced || manualDays}}"><checkbox-group class="pills" bindchange="weekdays"><label wx:for="{{dayOptions}}" wx:key="*this"><checkbox value="{{index}}"/>{{item}}</label></checkbox-group><view wx:if="{{manualDays}}">从四天模板开始 <switch checked="{{useFour}}" data-k="useFour" bindchange="field"/></view><view wx:else>从空白周自行编排 <switch checked="{{blank}}" data-k="blank" bindchange="field"/></view><button class="link" bindtap="bodyweight">按徒手生成</button></view>
<button class="primary" bindtap="generate" loading="{{busy}}">生成一周计划</button><button class="link wide" data-mode="week" bindtap="mode">返回周安排</button></block>
<block wx:elif="{{mode==='week'}}"><view class="subtitle">今天先练好，之后慢慢安排。</view><view wx:if="{{!preview}}" class="start-training"><view class="heading">自由组一套训练</view><view class="muted">选动作、调组次，马上开始。</view><button class="primary" bindtap="newToday"><image class="icon" src="/assets/tdesign/add-white.svg"/>新建今天训练</button></view><view class="between section-head"><text class="heading">本周安排</text><button class="link" data-mode="create" bindtap="mode">自动排一周</button></view><view class="muted">{{weekLabel}}</view><view wx:if="{{addId}}" class="callout">选择要加入「{{addName}}」的训练</view>
<view wx:for="{{courses}}" wx:key="key" class="week-course"><view class="between"><text class="muted">{{item.weekday}} · {{item.label}}</text><text class="tag {{item.status==='已完成'?'green':''}}">{{item.status==='待训练'?'已安排':item.status}}</text></view><view class="heading">{{item.title}}</view><view class="muted">{{item.count}} 个动作 · 约 {{item.minutes}} 分钟</view><view class="compact course-summary">{{item.summary || '等待添加动作'}}</view><view class="between course-controls"><button wx:if="{{!preview && item.status==='待训练'}}" class="link" data-date="{{item.date}}" data-key="{{item.key}}" bindtap="dateDialog">调整日期</button><text wx:else/><button class="link" data-date="{{item.date}}" data-key="{{item.key}}" bindtap="select">{{preview?'查看预览':'编辑训练'}}<image class="icon small" src="/assets/tdesign/chevron-right-blue.svg"/></button></view></view>
<view wx:if="{{!courses.length}}" class="empty">本周还没有安排训练<button class="link wide" bindtap="newToday">从今天的训练开始</button></view><block wx:if="{{preview}}"><button class="primary" bindtap="save">确认保存周计划</button><button class="link wide" bindtap="cancel">取消预览</button></block><view class="between section-head"><button class="link" data-n="-7" bindtap="week">上一周</button><button class="link" bindtap="browse">挑动作</button><button class="link" data-n="7" bindtap="week">下一周</button></view></block><block wx:else><view class="between session-subtitle"><text class="muted">{{sessionDateLabel}}</text><button class="link" data-mode="week" bindtap="mode">返回训练安排</button></view><view wx:if="{{daySessions.length>1}}" class="pills session-picker"><button wx:for="{{daySessions}}" wx:key="key" class="chip {{sessionKey===item.key?'on':''}}" data-key="{{item.key}}" bindtap="selectSession">{{item.label}}</button></view>
<block wx:if="{{session}}"><view class="session-name"><text class="muted">训练名称</text><input value="{{sessionName}}" bindinput="nameField" maxlength="40" disabled="{{preview || session.status!=='待训练'}}"/></view><view class="session-stats"><view><text>{{sessionCount}}</text> 个动作</view><view><text>{{sessionSets}}</text> 组</view><view><text>{{totalMinutes}}</text> 分钟左右</view></view><view class="warmup-line"><image class="icon small" src="/assets/tdesign/time-muted.svg"/><text>开始前，先活动一下</text><button class="link" bindtap="toggleSessionSettings">{{sessionSettings?'收起设置':'训练设置'}}</button></view>
<view wx:if="{{sessionSettings}}"><picker mode="date" value="{{date}}" bindchange="trainingDate"><view class="field">查看日期　{{date}}</view></picker><view wx:if="{{!preview && session.status==='待训练'}}"><picker range="{{goals}}" bindchange="sessionGoal"><view class="field">本次目标 · {{session.goal || meta.goal || '日常健身'}}</view></picker><button class="link" data-date="{{date}}" data-key="{{sessionKey}}" bindtap="dateDialog">调整本节日期</button></view><view wx:if="{{!preview && session.status==='待训练'}}" class="vcard"><view class="strong">活动消耗参考 · 选填</view><picker range="{{workoutTypes}}" bindchange="workoutType"><view class="field">{{workoutLabel}} ▾</view></picker><view class="fine">仅选择与本节实际活动及强度匹配的类型；混合训练不估算。有氧停止活动时请暂停。结果不增加饮食额度。</view><view wx:if="{{session.workoutType}}" class="fields"><label>年龄<input class="field" type="number" value="{{energyAge}}" data-k="energyAge" bindinput="energyField"/></label><label>体重 · kg<input class="field" type="digit" value="{{energyWeight}}" data-k="energyWeight" bindinput="energyField"/></label></view></view></view>
<view wx:if="{{warm.length}}" class="warmup-items"><view wx:for="{{warm}}" wx:key="key" class="between"><button class="link" data-id="{{item.id}}" bindtap="demo">{{item.name}} · {{item.target}} {{item.unit}}</button><button wx:if="{{!preview && session.status!=='已完成'}}" class="link" data-key="{{item.key}}" bindtap="editor">调整</button></view></view>
<view class="between section-head"><text class="heading">训练动作</text><button wx:if="{{!preview && session.status!=='已完成'}}" class="link" bindtap="browse"><image class="icon small" src="/assets/tdesign/add-blue.svg"/>添加</button></view>
<view wx:for="{{mainItems}}" wx:key="key" class="session-exercise"><view class="exercise-head"><text class="ordinal">{{item.ordinal}}</text><button class="exercise-view" data-id="{{item.id}}" bindtap="demo"><image src="{{item.cover}}" webp mode="aspectFit"/><view class="grow"><view class="strong">{{item.name}}</view><view class="muted">{{item.part}} · {{item.gear}}</view></view></button><button wx:if="{{!preview && session.status!=='已完成'}}" class="icon-button" data-key="{{item.key}}" bindtap="editor" aria-label="{{item.name}}操作"><image class="icon" src="/assets/tdesign/more-muted.svg"/></button></view><button class="prescription {{(preview || session.status==='已完成')?'is-disabled':''}}" data-key="{{item.key}}" bindtap="editor" disabled="{{preview || session.status==='已完成'}}"><view><text>{{item.sets}}</text> 组 × <text>{{item.target}}</text> {{item.unit}}</view><view>休息 {{item.rest}} 秒<image wx:if="{{!preview && session.status!=='已完成'}}" class="icon small" src="/assets/tdesign/edit-muted.svg"/></view></button><view wx:if="{{item.actual || item.previous}}" class="fine">实绩 {{item.actual||'—'}}　上次 {{item.previous||'—'}}</view><button wx:if="{{!preview && session.status==='训练中'}}" class="link wide" data-key="{{item.key}}" bindtap="editor">{{item.done >= item.sets?'加练一组':'记录完成'}}</button></view>
<view wx:if="{{!mainItems.length}}" class="empty"><image class="icon" src="/assets/tdesign/view-list-muted.svg"/><view class="heading">从第一个动作开始</view><view class="fine">一次可以选多个，再统一调整组次。</view></view><button wx:if="{{!preview && session.status!=='已完成'}}" class="secondary add-outline" bindtap="browse"><image class="icon small" src="/assets/tdesign/add-blue.svg"/>继续添加动作</button>
<view wx:if="{{session.timer}}" class="vcard"><view class="strong">已同步计时 {{timerSeconds}} 秒 · {{session.timer.running?'计时中':'已暂停'}}</view><view class="fine">离开训练页自动暂停。网络中断后请确认继续。</view><button wx:if="{{session.status==='训练中'}}" class="link" data-action="{{session.timer.running?'pause':'resume'}}" bindtap="train">{{session.timer.running?'暂停计时':'继续计时'}}</button></view><view wx:if="{{session.status==='已完成'}}" class="vcard"><view class="strong">活动消耗参考</view><block wx:if="{{session.energyEstimate.available}}"><view class="metric">约 {{session.energyEstimate.net}} <text>千卡 · 净活动消耗</text></view><view class="fine">含静息的总消耗约 {{session.energyEstimate.gross}} 千卡 · {{session.energyEstimate.type}} · {{session.energyEstimate.met}} {{session.energyEstimate.metBasis || 'MET'}}</view><view class="fine">{{session.energyEstimate.note}}</view></block><view wx:else class="fine">{{session.energyEstimate.reason||'此历史记录没有足够数据，暂无法估算。'}}</view></view><view wx:if="{{session.snapshot && sessionSettings}}" class="vcard"><view class="strong">开始时的计划</view><view wx:for="{{session.snapshot}}" wx:key="key" class="fine">{{item.name}} · {{item.sets}} 组 × {{item.target}} {{item.unit}}</view></view>
<view wx:if="{{!preview && session.status!=='已完成'}}" class="sticky-action"><text class="action-caption">{{session.status==='待训练'?'动作和组次已同步保存，可继续调整':'按实际记录的组数完成本节训练'}}</text><button wx:if="{{session.status==='待训练'}}" class="primary {{(!sessionHasItems)?'is-disabled':''}}" bindtap="saveTraining" loading="{{busy}}" disabled="{{!sessionHasItems}}">保存这套训练</button><button wx:else class="primary" data-action="finish" bindtap="train">完成本次训练</button></view>
</block><view wx:else class="empty"><view class="heading">安排这一天的训练</view><button class="primary" bindtap="newSession">新建训练</button></view><button wx:if="{{!preview}}" class="link wide" bindtap="newSession">新建另一节训练</button><button wx:if="{{addId}}" class="primary" bindtap="add">将「{{addName}}」加入本次训练</button></block>
<view wx:if="{{saveSheet}}" class="scrim"><view class="sheet"><view class="between"><text class="muted">练哪</text><button class="link" bindtap="closeSave">关闭</button></view><view class="rule"/><view class="heading">这套训练已保存</view><view>{{sessionName}} · {{sessionCount}} 个动作</view><view class="fine">可以继续调整，也可以开始训练。</view><view class="sheet-actions"><button class="secondary" bindtap="closeSave">继续编辑</button><button class="primary" bindtap="startSaved">开始训练</button></view></view></view><view wx:if="{{moveDate}}" class="scrim"><view class="sheet"><view class="between"><text class="muted">练哪</text><button class="link" bindtap="closeDate">关闭</button></view><view class="heading">移动训练日期</view><view class="fine">{{session.type}} · {{date}}</view><picker mode="date" value="{{destination}}" bindchange="destination"><view class="field">目标日期　{{destination}}</view></picker><view class="callout">同一周可并列安排另一节训练，或选择待训练课程交换；跨周顺延请选择空闲日。</view><button class="primary" bindtap="confirmDate">确认调整</button></view></view>
<view wx:if="{{edit}}" class="scrim"><view class="sheet exercise-editor"><view class="between"><text class="heading">{{edit.name}}</text><button class="link" bindtap="closeEdit">关闭</button></view><scroll-view scroll-y class="editor-scroll">
<view class="fields"><label>组数<input class="field" type="number" value="{{edit.sets}}" data-k="sets" bindinput="editField"/></label><label>每组{{edit.unit}}<input class="field" type="number" value="{{edit.target}}" data-k="target" bindinput="editField"/></label></view>
<label>组间休息 · 秒<input class="field" type="number" value="{{edit.rest}}" data-k="rest" bindinput="editField"/></label>
<view wx:if="{{session.status==='待训练'}}" class="between editor-future"><text>应用到后续同类训练</text><switch checked="{{edit.future}}" data-k="future" bindchange="editField"/></view>
<button class="primary" data-action="edit" bindtap="apply">保存组次与休息</button>
<block wx:if="{{session.status==='训练中'}}"><view class="rule"/><view class="fields"><label>本组实际{{edit.unit}}<input class="field" type="number" value="{{edit.value}}" data-k="value" bindinput="editField"/></label><label>重量 · kg（选填）<input class="field" type="digit" value="{{edit.weight}}" data-k="weight" bindinput="editField"/></label></view><button wx:if="{{edit.done < edit.sets}}" class="primary" data-action="record" bindtap="apply">记录本组</button><button wx:else class="primary" data-action="recordExtra" bindtap="apply">加练一组（保留原计划）</button></block>
<view class="editor-actions"><button class="link" bindtap="replacements">找替代动作</button><button class="link" data-action="reorder" bindtap="apply">上移一位</button><button class="link danger" data-action="remove" bindtap="apply">移除动作</button></view>
<view wx:for="{{candidates}}" wx:key="id" class="candidate"><button class="link" data-id="{{item.id}}" bindtap="demo">{{item.name}} · 演示</button><view class="fine">{{edit.sets-edit.done}} 组 × {{item.target}}{{item.unit}} · 休息 {{item.rest}} 秒</view><button class="secondary" data-id="{{item.id}}" data-action="replace" bindtap="apply">确认替换</button></view>
</scroll-view></view></view></view>
