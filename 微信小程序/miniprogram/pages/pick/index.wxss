.search-box{background:#edf0fa;border-radius:26px;display:flex;align-items:center;padding:0 15px;gap:8px;height:48px}.search-box input{flex:1;font-size:13px;height:44px;min-width:0}.source-tabs{display:flex;gap:23px;border-bottom:1px solid #e1e5ef;margin:14px 0 6px}.source-tab{font-size:14px;min-height:45px;position:relative;color:#68718a;padding:5px 0}.source-tab.on{color:#2448d8;font-weight:650;border-bottom:3px solid #2448d8}.part-scroll{width:calc(100% + 40px);margin:0 -20px;white-space:nowrap}.part-pills{display:inline-flex;gap:7px;padding:13px 20px 6px}.part-pills .chip{white-space:nowrap;font-size:12px;min-height:35px;padding:7px 12px}.equipment-line,.equipment-line>view{display:flex;align-items:center;gap:5px}.equipment-line{justify-content:space-between;color:#69748b;font-size:11px}.equipment-line .link{font-size:11px}.category-filter{display:flex;align-items:center;justify-content:space-between;color:#69748b;font-size:11px;margin:0 0 10px}.exercise-list{background:white;border-radius:18px;border:1px solid #e5e8f0;padding:0 12px}.group{margin-top:15px}.group-head{font-size:12px}.catalog-footnote{font-size:11px;text-align:center;color:#7b8395;margin:18px 0}.selecting{padding-bottom:calc(125px + env(safe-area-inset-bottom))}
