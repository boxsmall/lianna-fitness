.part-grid{display:flex;flex-wrap:wrap;justify-content:space-between;margin-top:12rpx}
.part{display:flex;align-items:center;justify-content:center;width:24%;min-height:84rpx;margin-top:10rpx;border:2rpx solid #d9dde4;border-radius:12rpx;background:white;font-weight:600}
.part.on{color:#2448d8;background:#edf1ff;border-color:#2448d8}
.part[disabled]{background:#f1f2f1;color:#9098a6}
.results{padding-top:26rpx}
.warm-label{margin:0 0 14rpx}


.screen{padding-bottom:calc(82px + env(safe-area-inset-bottom))}

.selection-dock{position:fixed;bottom:0;left:0;right:0;padding:14px 20px calc(14px + env(safe-area-inset-bottom));background:#fff;border-top:1px solid #e0e4eb;z-index:20}.selection-dock .primary{margin-top:8px}.selecting{padding-bottom:170px}
