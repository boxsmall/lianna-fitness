<view class="screen {{selecting?'selecting':''}}"><view class="header"><text class="title">{{selecting?'添加训练动作':'挑选动作'}}</text></view><view class="subtitle">{{selecting?'一次选多个，加入本次训练':'找到适合今天的动作。'}}</view>
<view class="search-box"><image class="icon" src="/assets/tdesign/search-muted.svg"/><input value="{{query}}" placeholder="搜索动作或部位" bindinput="search" confirm-type="search"/></view><view class="source-tabs"><button class="source-tab {{source==='all'?'on':''}}" data-source="all" bindtap="source">全部动作</button><button class="source-tab {{source==='favorites'?'on':''}}" data-source="favorites" bindtap="source">我的收藏</button></view>
<scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="part-scroll"><view class="part-pills"><button class="chip {{!hasParts && category==='全部'?'on':''}}" bindtap="all">全部</button><button wx:for="{{parts}}" wx:key="name" class="chip {{item.selected?'on':''}} {{(item.disabled)?'is-disabled':''}}" disabled="{{item.disabled}}" data-name="{{item.name}}" bindtap="selectPart">{{item.name}}</button><button class="chip {{category==='热身'?'on':''}}" data-name="热身" bindtap="selectCategory">热身</button></view></scroll-view>
<view class="equipment-line"><view><image class="icon small" src="/assets/tdesign/filter-muted.svg"/><text>{{activeLabel}}</text></view><button class="link" bindtap="equipment">调整器械</button></view><picker range="{{categories}}" bindchange="muscle"><view class="category-filter">{{category==='全部'?'全部肌群':category}} · {{total}} 个动作<image class="icon small" src="/assets/tdesign/chevron-right-muted.svg"/></view></picker>
<view wx:for="{{sections}}" wx:for-item="group" wx:key="name" class="group"><view class="between group-head"><text class="subheading">{{group.name}}</text><text class="count">{{group.count}}</text></view><view class="exercise-list"><move-row class="exercise-choice" wx:for="{{group.rows}}" wx:for-item="move" wx:key="id" move="{{move}}" selecting="{{selecting}}" bind:select="toggleMove" bind:changed="refresh"/></view><button wx:if="{{group.more}}" class="link more" data-name="{{group.name}}" bindtap="more">查看更多（{{group.more}}）</button></view><view wx:if="{{!sections.length}}" class="empty">{{source==='favorites'?'当前筛选下暂无收藏动作':'没有找到符合条件的动作'}}<button class="link wide" bindtap="all">查看全部部位</button></view><view class="catalog-footnote">热身不限器械 · 已加入的动作也可再次添加</view></view>
<view wx:if="{{selecting}}" class="selection-dock"><view class="error" wx:if="{{error}}">{{error}}</view><text class="action-caption">已选 {{selectedCount}} 个 · 原有 {{existingCount||0}} 个动作保留</text><button class="primary {{(!selectedCount || busy)?'is-disabled':''}}" disabled="{{!selectedCount || busy}}" loading="{{busy}}" bindtap="confirmSelection">加入训练 · {{selectedCount}} 个动作</button></view><main-nav wx:else active="week"/>
