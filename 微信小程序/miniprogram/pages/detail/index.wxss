.move-title{font-size:46rpx;line-height:1.3;font-weight:700;margin-bottom:22rpx}
.stage{position:relative;width:100%;height:620rpx;background:white;border:1rpx solid #dce5f5;border-radius:14rpx;overflow:hidden}
.visual{position:absolute;left:0;top:0;width:100%;height:100%}
.meta-row{justify-content:flex-start;padding:20rpx 0;border-bottom:1rpx solid #d9dde4;font-size:28rpx}
.meta-row text:first-child{min-width:155rpx;font-weight:650}
.media-note{margin-top:12rpx}
.step{display:flex;margin-top:18rpx;line-height:1.65}
.step-number{color:#2448d8;min-width:45rpx;font-weight:650}
.saved-hint{text-align:center;color:#596476;font-size:24rpx;margin-bottom:8rpx}

.stage{height:270px;margin:18px 0 8px}.step{font-size:14px}.screen .primary{margin-top:24px}

.screen{padding-bottom:calc(82px + env(safe-area-inset-bottom))}
