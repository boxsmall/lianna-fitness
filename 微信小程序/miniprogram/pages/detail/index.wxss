.stage{position:relative;width:100%;height:290px;background:white;border:1px solid #e3e7f1;border-radius:24px;overflow:hidden;padding:12px;margin:22px 0 8px}.visual{position:absolute;left:12px;top:12px;width:calc(100% - 24px);height:calc(100% - 24px);border-radius:18px}.stage-control{position:absolute;right:12px;bottom:12px;min-height:34px;background:#eef1f9;border-radius:20px;padding:7px 11px;color:#475579;font-size:12px;display:flex;align-items:center;gap:5px}.detail-meta{margin:9px 0 26px}.step{display:flex;gap:12px;font-size:13px;line-height:1.8;padding-bottom:12px;margin-top:17px}.step-number{font-size:12px;font-weight:500;color:#2448d8;min-width:26px;padding-top:1px}.media-note{font-size:12px;margin:12px 0}
