.profile-card{display:flex;gap:13px;align-items:center;padding:19px 16px;background:#e5eaff;border-radius:22px;width:100%;text-align:left;margin-top:22px}.profile-card>image:first-child{width:46px;height:46px;flex-shrink:0;border-radius:12px}.profile-card .heading{font-size:17px}.profile-card .muted{font-size:11px;margin-top:5px}.profile-stats{display:flex;margin:22px 0 26px}.profile-stats button{flex:1;color:#737a8a;font-size:11px;border-right:1px solid #e0e5f0}.profile-stats button:last-child{border:0}.profile-stats view{font-size:24px;color:#26385e;font-weight:600;margin-bottom:8px}.cell-group{background:white;border:1px solid #e3e7f1;border-radius:18px;padding:0 18px}.menu-row{display:flex;align-items:center;gap:14px;width:100%;text-align:left;min-height:60px;font-size:13px}.signature{text-align:center;color:#8a91a2;font-size:11px;margin:26px 0}.profile-avatar{width:50px;height:50px;border-radius:50%;flex-shrink:0}.avatar-picker{display:flex;align-items:center;justify-content:center;gap:12px;margin:24px 0;padding:20px}textarea.field{min-height:110px;width:100%}
