@import "theme.wxss";
page{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:14px;line-height:1.6;background:#f8f9ff;color:#202330}
view,button,input,image,scroll-view,textarea{box-sizing:border-box}
button{background:transparent;color:inherit;margin:0;padding:0;border:0;line-height:1.5;font-size:14px;border-radius:0}button::after{border:0}button.is-disabled{color:#8c95ab}button.primary.is-disabled{background:#acb9eb;color:white}
.screen{padding:12px 20px calc(92px + env(safe-area-inset-bottom));min-height:100vh}.header,.between,.meta-row{display:flex;align-items:center;justify-content:space-between;gap:10px}.header{margin-bottom:7px}.title{font-size:26px;font-weight:700;line-height:1.35;letter-spacing:-.8px}.header .brand{display:none}.brand{width:60px;height:26px;flex-shrink:0}.subtitle,.muted,.count{font-size:12px;line-height:1.7;color:#626774}.subtitle{margin:8px 0 20px}.heading{font-size:19px;line-height:1.4;font-weight:650}.subheading,.strong{font-size:14px;font-weight:600}.section-head{margin:26px 0 14px}.section{padding:20px 0;border-bottom:1px solid #e3e5ed}.link{min-height:40px;padding:7px 0;color:#2448d8;font-size:12px;font-weight:500;display:inline-flex;align-items:center;justify-content:center;gap:5px}.primary,.secondary{width:100%;min-height:48px;padding:11px 16px;border-radius:28px;display:flex;align-items:center;justify-content:center;gap:7px;font-size:14px;font-weight:600}.primary{background:#2448d8;color:white}.secondary{border:1px solid #8d9bd1;color:#2448d8;background:transparent}.primary .icon{width:20px;height:20px}.icon{width:20px;height:20px;flex-shrink:0}.icon.small{width:16px;height:16px}.wide{width:100%}.vcard{background:#f0f1fa;border:0;border-radius:20px;padding:20px;margin:12px 0}.vcard .primary{margin-top:18px}.tag{display:inline-block;background:#e5eaff;color:#34488c;padding:5px 8px;font-size:10px;line-height:1.5;border-radius:8px}.tag.green{background:#dcefe4;color:#225940}.metric{font-size:32px;font-weight:700;line-height:1.3;letter-spacing:-1px;margin:10px 0 20px}.metric text{font-size:11px;color:#626774;font-weight:400;letter-spacing:0}.metric-grid{display:flex;gap:10px;margin:20px 0 8px}.metric-grid>view{flex:1;min-width:0}.metric-grid>view+view{border-left:1px solid #dfe3ef;padding-left:10px}.num{font-size:23px;font-weight:600;line-height:1.5}.num text{font-size:11px;color:#626774;font-weight:400}.field{width:100%;border:1px solid #b8bdcd;border-radius:12px;padding:11px 12px;min-height:46px;height:auto;margin:7px 0 18px;background:transparent;font-size:14px;color:#202330;line-height:1.5}input.field{height:46px;padding:0 12px;line-height:46px}.fields{display:flex;gap:12px}.fields>label,.fields>view{flex:1;min-width:0}label{font-size:14px}.pills{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0 22px}.chip{min-height:38px;border:1px solid #cfd3df;background:transparent;border-radius:10px;padding:8px 12px;font-size:13px}.chip.on{background:#dfe5ff;border-color:#dfe5ff;color:#203b8b;font-weight:600}.chip.is-disabled{opacity:.5}.callout{background:#eef1fa;color:#626c81;border-radius:12px;padding:13px;font-size:12px;line-height:1.7;margin:16px 0}.fine,.compact{font-size:11px;color:#6d7585;line-height:1.8}.fine{margin:12px 0}.rule{border-top:1px solid #e3e7f0;margin:14px 0}.error{color:#a13127;background:#fff0ed;border-radius:10px;padding:10px 12px;font-size:12px;line-height:1.7;margin:12px 0}.error:empty{display:none}.empty{padding:32px 18px;background:#f0f2fa;border-radius:20px;text-align:center;color:#69748b;font-size:13px;margin:20px 0}.group{margin-top:22px}.group-head{margin-bottom:10px}.more{display:block;margin:6px auto}.tabs{width:100%;white-space:nowrap;margin:12px 0}.tabs-inner{display:inline-flex;gap:7px}.tab{display:inline-flex;align-items:center;min-height:38px;border:1px solid #cfd3df;border-radius:10px;padding:8px 12px;font-size:13px}.tab.on{background:#dfe5ff;border-color:#dfe5ff;color:#203b8b;font-weight:600}.panel{background:white;border:1px solid #e3e7f1;border-radius:18px;overflow:hidden}.vrow{display:block;text-align:left;padding:16px 0;border-bottom:1px solid #e3e7f0}.scrim{position:fixed;inset:0;background:rgba(25,35,58,.43);z-index:30;display:flex;align-items:flex-end;justify-content:center;padding:0}.sheet{width:100%;max-height:85vh;overflow:auto;background:white;padding:22px 20px calc(24px + env(safe-area-inset-bottom));border-radius:24px 24px 0 0}.sheet .link{margin-right:12px}.sheet label{display:block}.sheet .fields label{flex:1}.sheet .heading{margin:12px 0 20px}.sheet .between{gap:12px}.sheet-actions{display:flex;gap:10px;margin-top:20px}.sheet-actions button{flex:1}.with-dock{padding-bottom:calc(120px + env(safe-area-inset-bottom))}.dock,.selection-dock,.sticky-action{position:fixed;z-index:15;left:0;right:0;bottom:0;background:#f8f9ff;border-top:1px solid #e3e6f0;padding:12px 20px calc(14px + env(safe-area-inset-bottom))}.action-caption{display:block;text-align:center;color:#69738a;font-size:11px;margin-bottom:8px}.thumb{width:64px;height:68px;background:white;border-radius:12px;flex-shrink:0}.choice-row{display:flex;gap:12px;align-items:center}.grow{flex:1;min-width:0}.inline-actions{display:flex;align-items:center;justify-content:space-between;gap:8px}.menu-row{min-height:60px;border-bottom:1px solid #e8ebf3;font-size:13px}.menu-row:last-child{border:0}.history-row.rule{height:auto;background:transparent;padding-top:14px}.meal-weight{width:76px;margin:0;text-align:center}.recipe-card{margin-bottom:12px}.picks{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:18px 0}.picks input{width:80px}.segment{padding:14px 0 20px;border-bottom:1px solid #e3e7f0}.dateline{font-size:12px;color:#626774;padding:16px 0}.energy{font-size:24px;font-weight:650}
