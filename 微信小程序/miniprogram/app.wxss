page{background:#fbfaf7;color:#171c25;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:30rpx}
view,button,input,image,scroll-view{box-sizing:border-box}
button{background:transparent;color:inherit;margin:0;padding:0;border:none;line-height:1.4;font-size:28rpx;border-radius:0}
button::after{border:none}
button[disabled]{color:#8a919e}
.screen{padding:28rpx 28rpx 52rpx}
.header,.between,.meta-row{display:flex;align-items:center;justify-content:space-between}
.header{padding-bottom:22rpx;border-bottom:1rpx solid #d9dde4}
.title{font-size:55rpx;font-weight:750;line-height:1.15;letter-spacing:-2rpx}
.brand{width:140rpx;height:54rpx}
.section{padding:24rpx 0;border-bottom:1rpx solid #d9dde4}
.heading{font-size:36rpx;line-height:1.4;font-weight:650}
.subheading{font-size:30rpx;font-weight:650}
.link{min-height:72rpx;padding:12rpx 4rpx;color:#2448d8;font-weight:600;display:inline-flex;align-items:center;justify-content:center}
.count,.muted{font-size:25rpx;color:#596476;line-height:1.5}
.tabs{width:100%;white-space:nowrap;border-bottom:1rpx solid #d9dde4;margin:12rpx 0}
.tabs-inner{display:inline-flex}
.tab{display:inline-flex;align-items:center;min-height:84rpx;padding:10rpx 18rpx;border-bottom:4rpx solid transparent;font-weight:600}
.tab.on{color:#2448d8;border-color:#2448d8}
.group{margin-top:26rpx}
.group-head{margin-bottom:12rpx}
.panel{border:1rpx solid #e1e3e9;border-radius:14rpx;overflow:hidden;background:white}
.more{display:block;margin:6rpx auto}
.empty{padding:50rpx 22rpx;text-align:center;color:#596476;line-height:1.7}
.primary{width:100%;min-height:88rpx;border-radius:12rpx;background:#2448d8;color:#fff;display:flex;justify-content:center;align-items:center;font-size:30rpx;font-weight:650}
.dock{position:fixed;z-index:2;left:0;right:0;bottom:0;background:#fbfaf7;border-top:1rpx solid #d9dde4;padding:14rpx 28rpx;padding-bottom:calc(14rpx + env(safe-area-inset-bottom))}
.with-dock{padding-bottom:calc(146rpx + env(safe-area-inset-bottom))}

.vcard{background:#fff;border:1rpx solid #dce1e1;border-radius:20rpx;padding:26rpx;margin:20rpx 0}
.vcard .primary{margin-top:20rpx}.vrow{display:block;text-align:left;padding:18rpx 0;border-bottom:1rpx solid #e6e9e8}
.dateline{font-size:26rpx;color:#536475;padding:16rpx 0}.energy{font-weight:700;font-size:42rpx}
.picks{display:flex;align-items:center;gap:12rpx;flex-wrap:wrap;margin:18rpx 0}.picks input{width:165rpx}
.field{min-height:76rpx;padding:12rpx 16rpx;margin:8rpx 0 18rpx;background:#f5f6f8;border:1rpx solid #d6dce1;border-radius:10rpx;font-size:28rpx}
.segment{padding:14rpx 0 20rpx;border-bottom:1rpx solid #dce1e4}.error{color:#933b29;font-size:27rpx;line-height:1.5;margin:12rpx 0}

.screen{padding:10px 20px 40px}.header{border:0;padding:0;gap:10px}.title{font-size:29px;color:#171c25;line-height:1.3;letter-spacing:-1px}.brand{width:70px;height:32px;flex-shrink:0}.subtitle,.muted,.count{font-size:12px;line-height:1.7;color:#697385}.subtitle{margin-top:9px}.heading{font-size:19px}.subheading,.strong{font-size:15px;font-weight:650}.section-head{margin:23px 0 12px}.link{font-size:14px;min-height:40px;padding:7px 0;color:#2448d8;font-weight:500}.primary{border-radius:7px;min-height:43px;font-size:14px}.vcard{border:1px solid #e0e4eb;border-radius:12px;padding:18px;background:white;margin:12px 0}.tag{display:inline-block;background:#edf1ff;color:#2448d8;padding:4px 8px;font-size:11px;border-radius:5px}.metric{font-size:32px;font-weight:700;letter-spacing:-1px;margin:10px 0 16px}.metric text{font-size:12px;color:#697385;font-weight:400;letter-spacing:0}.pills{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0 18px}.chip{font-size:14px;border:1px solid #d8dde5;background:white;border-radius:7px;padding:10px 12px}.chip.on{border-color:#2448d8;background:#edf1ff;color:#2448d8;font-weight:600}.field{background:white;border:1px solid #ccd3df;border-radius:7px;padding:9px 12px;min-height:40px;height:auto;margin:8px 0 18px}.fields{display:flex;gap:12px}.fields>label,.fields>view{flex:1;min-width:0}.callout{background:#edf1ff;color:#41548f;border-radius:8px;padding:12px;font-size:12px;line-height:1.65;margin:14px 0}.rule{border-top:1px solid #e0e4eb;margin:14px 0}.screen .wide{width:100%}.metric-grid{display:flex;gap:12px;margin:18px 0}.metric-grid>view{flex:1;min-width:0}.num{font-size:21px;font-weight:700}.num text{font-size:12px;color:#697385;font-weight:400}.screen .vrow{font-size:14px}.scrim{position:fixed;inset:0;background:rgba(21,33,60,.4);z-index:9;display:flex;align-items:center;justify-content:center;padding:14px}.sheet{width:100%;max-width:460px;max-height:78vh;overflow:auto;padding:22px;background:white;border-radius:15px}.sheet .link{margin-right:12px}.sheet label{display:block}.with-dock{padding-bottom:100px}.fine{font-size:12px;color:#697385;margin:12px 0}.thumb{width:64px;height:68px;background:white;border:1px solid #edf0f4;border-radius:7px}.choice-row{display:flex;gap:12px;align-items:center}.choice-row .grow{flex:1}.compact{font-size:12px;line-height:1.7;color:#697385}.inline-actions{display:flex;justify-content:space-between;align-items:center;gap:8px}.menu-row{border-bottom:1px solid #e0e4eb;min-height:63px;font-size:14px}.tabs{border:0}.tab{min-height:40px;border:1px solid #d8dde5;background:white;border-radius:7px;margin:4px;padding:8px 12px}.tab.on{background:#edf1ff;border:1px solid #2448d8}

.history-row.rule{height:auto;background:transparent;border-top:1px solid #e0e4eb;padding-top:12px}.screen{min-height:100vh}.meal-weight{width:76px;text-align:center;padding:8px;margin:0 6px}.recipe-card{margin-bottom:12px}
